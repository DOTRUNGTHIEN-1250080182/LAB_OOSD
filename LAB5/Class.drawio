        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam classAttributeIconSize 0\nskinparam class {\n    BackgroundColor #FFF2CC\n    BorderColor #D6B656\n    ArrowColor Black\n}\n\nclass KhachHang {\n   {static} MaKH: string\n   TenKH: string\n   DienThoai: string\n   DiaChi: string\n   DangKyTour(): void\n   ThanhToan(): void\n   LamKhaoSat(): void\n}\n\nclass KhachDoan {\n   TenCoQuan: string\n   NguoiDaiDien: string\n   SoNguoiDi: int\n   DiaDiemDon: string\n   DaDatCoc: bool\n   ThanhToanTienCoc(): void\n   ThanhToanKinhPhiThamQuan(): void\n   CungCapDanhSachBaoHiem(): void\n}\n\nclass KhachLe {\n   DiemBanVe: string\n   SoNguoiDi: int\n   ThanhToanTienVe(): void\n}\n\nclass HanhKhach {\n   {static} MaHanhKhach: string\n   HoTen: string\n   CMND_CCCD: string\n   ThemHanhKhach(): void\n   XoaHanhKhach(): void\n}\n\nclass Tour {\n   {static} MaTour: string\n   TenTour: string\n   SoNgay: int\n   SoDem: int\n   DonGiaKhach: decimal\n   ThemTour(): void\n   CapNhatTour(): void\n   TinhTongGia(): decimal\n}\n\nclass ChuyenDi {\n   {static} MaChuyen: string\n   NgayDi: Datetime\n   NgayVe: Datetime\n   TaoChuyenDi(): void\n   CapNhatLich(): void\n   PhanCongNhanVien(): void\n}\n\nclass PhieuDangKy {\n   {static} MaPhieu: string\n   NgayLap: Datetime\n   TongTien: decimal\n   TrangThaiThanhToan: string\n   LapPhieu(): void\n   HuyPhieu(): void\n   CapNhatTrangThai(): void\n}\n\nclass NhanVien {\n   {static} MaNV: string\n   HoTen: string\n   DienThoai: string\n   LuongCanBan: decimal\n   TinhLuong(): decimal\n   NhanLichPhanCong(): void\n}\n\nclass DiemDungChan {\n   {static} MaDiemDung: string\n   TenDiem: string\n   CoDoiPhuongTien: bool\n   CoNoiAn: bool\n   CoKhachSan: bool\n   LoaiKhachSan: int\n   CapNhatThongTin(): void\n}\n\nclass DiemThamQuan {\n   {static} MaDiemTQ: string\n   TenDiemThamQuan: string\n   DiaDiem: string\n   NoiDung: string\n   YNghia: string\n   XemThongTin(): void\n}\n\nclass PhuongTien {\n   {static} MaPT: string\n   LoaiPhuongTien: string\n   CapNhatPhuongTien(): void\n}\n\nclass PhieuKhaoSat {\n   {static} MaKhaoSat: string\n   NgayGui: Datetime\n   NoiDungGopY: string\n   GuiPhieu(): void\n   GhiNhanGopY(): void\n}\n\n&#39; === KẾ THỪA ===\nKhachHang &lt;|-- KhachDoan\nKhachHang &lt;|-- KhachLe\n\n&#39; === HỢP THÀNH ===\nKhachDoan \&quot;1\&quot; *-- \&quot;0..*\&quot; HanhKhach : Kèm danh sách &gt;\nTour \&quot;1\&quot; *-- \&quot;1..*\&quot; DiemDungChan : Gồm &gt;\n\n&#39; === LIÊN KẾT ===\nTour \&quot;1\&quot; -- \&quot;1..*\&quot; ChuyenDi : Có &gt;\nTour \&quot;0..*\&quot; -- \&quot;0..*\&quot; DiemThamQuan : Tham quan &gt;\nTour \&quot;1\&quot; -- \&quot;1..*\&quot; PhuongTien : Dùng &gt;\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuDangKy : Lập &gt;\nPhieuDangKy \&quot;0..*\&quot; -- \&quot;1\&quot; ChuyenDi : Đăng ký &gt;\nNhanVien \&quot;1..*\&quot; -- \&quot;0..*\&quot; ChuyenDi : Phụ trách &gt;\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhaoSat : Điền &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="etszQf1D4oO4ExGCUwWZ-423">
